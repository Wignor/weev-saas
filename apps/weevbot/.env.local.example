# Evolution API
EVOLUTION_API_URL=https://sua-evolution.exemplo.com
EVOLUTION_INSTANCE=nome-da-instancia
EVOLUTION_API_KEY=sua-api-key

# Upstash Redis
# Crie em: https://console.upstash.com → New Database → REST API
UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxx

# Supabase
# Crie em: https://supabase.com → Settings → API
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJxxx  # service_role key (não a anon key)

# OpenAI
OPENAI_API_KEY=sk-xxx

# Prompt do agente (opcional — substitui o padrão)
# AGENT_SYSTEM_PROMPT=Você é um assistente de atendimento da Empresa X...
